# --- Viessmann ViCare API ---
# Crea l'app a https://developer.viessmann.com
VICARE_CLIENT_ID=el_teu_client_id
VICARE_REDIRECT_URI=http://localhost:3000/auth/vicare/callback
VICARE_INSTALLATION_ID=
VICARE_GATEWAY_SERIAL=
VICARE_DEVICE_ID=0
# Circuit de calefacció a controlar (normalment 0)
VICARE_CIRCUIT=0
# Valors del mode "engegat"/"aturat" — confirma'ls a /api/vicare/status
# (busca "heating.circuits.X.operating.modes.active" -> commands.setMode.params.mode.constraints.enum)
VICARE_MODE_ON=heatingCooling
VICARE_MODE_OFF=standby
# Programa actiu per canviar el setpoint de temperatura — confirma'l a /api/vicare/status
# ("heating.circuits.X.operating.programs.active" -> value). Sol ser 'normal', 'comfort'...
VICARE_PROGRAM=normal
# Nom exacte de la feature de temperatura de sala — confirma'l a /api/vicare/status
# si el valor per defecte no funciona (no totes les instal·lacions tenen sonda ambient)
VICARE_ROOM_TEMP_FEATURE=

# --- Tuya Cloud (IoT Platform) ---
# Crea un projecte "Cloud" a https://iot.tuya.com
TUYA_ACCESS_ID=el_teu_access_id
TUYA_ACCESS_SECRET=el_teu_access_secret
# Regió del datacenter: eu, us, cn, in...
TUYA_ENDPOINT=https://openapi.tuyaeu.com
# ID del dispositiu FT4W (es veu al panell de Tuya IoT un cop vinculat amb l'app Smart Life)
TUYA_DEVICE_ID=el_device_id_del_ft4w
# "code" per engegar/aturar (sol ser 'switch' o 'switch_1' — confirma'l amb "Debug device")
TUYA_POWER_CODE=switch

# --- Persistència dels tokens ViCare (només cal a Vercel) ---
# Amb la integració "Upstash Redis" del Vercel Marketplace connectada al projecte,
# Vercel injecta aquestes dues automàticament — no cal omplir-les a mà.
# En local, si les deixes buides, els tokens es guarden a .tokens.vicare.json com sempre.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

PORT=3000
